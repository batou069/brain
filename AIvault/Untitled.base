views:
  - type: table
    name: Table
    filters:
      and:
        - '!file.name.endsWith("_MOC")'
        - "!aliases.isEmpty()"
    order:
      - file.name
      - aliases
      - related
      - tags
    sort:
      - property: related
        direction: ASC
    rowHeight: medium
  - type: cards
    name: View
    filters:
      and:
        - '!file.name.endsWith("_MOC")'
    image: note.aliases
    imageFit: contain
    imageAspectRatio: 0.3
    cardSize: 240
